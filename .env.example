# ============================================
# TAXI PROJECT — Environment Variables
# ============================================

# 🔑 License
LICENSE_KEY=
LICENSE_SERVER_URL=https://license-server-phi-eight.vercel.app
LICENSE_SERVER_SECRET=
LICENSE_PRODUCT=neo-taxi

# 🗄️ Database (Neon PostgreSQL recommended)
# Pooled/runtime connection.
DATABASE_URL=
# Direct/unpooled connection to the same database, branch, and schema.
DIRECT_URL=

# 🔐 Auth
NEXTAUTH_SECRET=                        # openssl rand -base64 32
NEXTAUTH_URL=https://yourdomain.com

# 🔐 Google OAuth (optional)
GOOGLE_ID=
GOOGLE_SECRET=

# 💳 Stripe (optional for cash-only deployments; all three values are required for cards)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stable, unique identifier for this site when a Stripe account serves multiple deployments.
STRIPE_DEPLOYMENT_ID=taxi-yourdomain-com
# Required by the included Vercel reconciliation cron. On other hosts, send this
# value as `Authorization: Bearer <CRON_SECRET>` when scheduling the same route.
CRON_SECRET=                          # openssl rand -base64 32

# 🗺️ Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Separate restricted server key with Routes API enabled; never expose this key.
GOOGLE_MAPS_SERVER_API_KEY=

# 📧 Email (Resend — free 3000/mo at resend.com)
RESEND_API_KEY=re_...
EMAIL_FROM=bookings@yourdomain.com      # Must be verified domain in Resend

# ☁️ OPTIONAL — built-in Cloudinary uploader; configure both values together
# Without these values, admins can still paste hosted image URLs manually.
# Use an image-only unsigned preset. No Cloudinary API secret is used by this widget.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# 🚦 OPTIONAL — distributed Upstash rate limiting; configure both or neither
# The site remains deployable without Upstash and does not create a provider client.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 🌐 App URL
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# 📬 Admin Email (fallback if not set in DB settings)
ADMIN_EMAIL=admin@yourdomain.com

# 🎨 Optional presentation and analytics fallbacks
# Primary values normally come from CMS/database settings.
NEXT_PUBLIC_STORE_NAME=
NEXT_PUBLIC_STORE_URL=https://yourdomain.com
STORE_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_CURRENCY_SYMBOL=
NEXT_PUBLIC_GA_ID=
